# ──────────────────────────────────────────────────────────
# FRONTEND ENVIRONMENT VARIABLES
# Copy this file to .env and fill in the values for your env.
# ──────────────────────────────────────────────────────────

# Backend API base URL (must include /api)
# Development:  http://localhost:4000/api        (Vite proxy handles CORS)
# Production:   https://api.yoursite.com/api
VITE_API_URL=http://localhost:4000/api
